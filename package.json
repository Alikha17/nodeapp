{
  "name": "nodeapp",
  "version": "1.0.0",
  "description": "Node.js CI/CD demo app",
  "main": "src/server.js",
  "files": ["src"],
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "coverageReporters": ["lcov", "text"]
  }
}
